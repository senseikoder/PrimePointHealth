---
import "../styles/global.css";

interface Props {
   title?: string;
   description?: string;
}

const {
   title = "HealthConsult - Transforming Healthcare Delivery",
   description = "We are a premier healthcare consultancy helping medical institutions develop immersive and patient-centric experiences.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
   <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width" />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <meta name="generator" content={Astro.generator} />
      <title>{title}</title>
      <meta name="description" content={description} />

      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link
         href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
         rel="stylesheet"
      />
      <link
         href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined"
         rel="stylesheet"
      />
   </head>
   <body
      class="bg-background-light text-navy-900 transition-colors duration-300"
   >
      <slot />
   </body>
</html>
