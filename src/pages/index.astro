---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Mission from "../components/Mission.astro";
import Aproach from "../components/Aproach.astro";
import WhyUs from "../components/WhyUs.astro";
import Footer from "../components/Footer.astro";
import Image from "astro/components/Image.astro";

import pph_main_pic from "../images/PPH_Main_photo.webp";
const title = "PrimePoint Health - Transforming Healthcare Delivery";
const description = "We are a premier healthcare consultancy helping medical institutions develop immersive and patient-centric experiences.";
---

<Layout title = {title} description = {description}>
   <Nav />

   <main>
      <section class="pt-32 pb-20 bg-navy-900 text-center px-6">
         <div class="max-w-4xl mx-auto">
            <h1
               class="text-5xl md:text-7xl font-extrabold text-white mb-8 leading-tight"
            >
               Welcome to <br>PrimePoint Health
            </h1>
            <p
               class="text-white/60 text-lg md:text-xl max-w-4xl mx-auto mb-16 leading-relaxed"
            >
               <strong>PrimePoint Health</strong> is a strategic healthcare consulting firm dedicated to driving transformative improvements in health organizations. We partner with healthcare providers, payers, and public agencies to navigate complex challenges and achieve sustainable, mission-driven results. Our team combines deep industry expertise with innovative thinking to help you deliver better care, improve outcomes, and optimize performance.
            </p>
            <div
               class="relative w-full max-w-5xl mx-auto mt-12 rounded-xl overflow-hidden shadow-2xl"
            >
               <Image
                  alt="Modern healthcare consulting professionals"
                  class="w-full h-auto object-cover aspect-video"
                  src={pph_main_pic}
                  width={1200}
                  height={600}
               />
            </div>
         </div>
      </section>

      <Mission />
      <Aproach />
      <WhyUs />

   </main>


   <Footer />
</Layout>
