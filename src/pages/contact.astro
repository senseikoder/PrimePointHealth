---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Nav />
  
  <main>
    <!-- Hero Section -->
    <section class="py-32 pt-48 px-4 bg-navy-900 text-center">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-6 leading-normal">
          Contact Us
        </h1>
        <p class="text-xl text-gray-300 leading-relaxed">
          Get in Touch
        </p>
      </div>
    </section>

    <!-- Contact Information Section -->
    <section class="py-20 px-4 bg-white">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none">
          <p class="text-gray-600 leading-relaxed mb-8">
            Ready to drive meaningful change in your organization? Let's start the conversation. We welcome inquiries from health system executives, medical group leaders, payers, policymakers, and other industry partners who are looking for guidance and results.
          </p>
        </div>

        <div class="bg-gray-50 border border-navy-900/10 rounded-sm p-8 md:p-12 mb-12">
          <h2 class="text-2xl font-bold text-navy-900 mb-8">Contact PrimePoint Health:</h2>
          
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center shrink-0">
                <span class="material-icons-outlined text-navy-900">email</span>
              </div>
              <div>
                <p class="text-sm font-bold uppercase tracking-widest text-navy-900/40 mb-1">Email</p>
                <p class="text-lg text-navy-900">info@primepointhealth.com</p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center shrink-0">
                <span class="material-icons-outlined text-navy-900">phone</span>
              </div>
              <div>
                <p class="text-sm font-bold uppercase tracking-widest text-navy-900/40 mb-1">Phone</p>
                <p class="text-lg text-navy-900">(617) 970-8519</p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center shrink-0">
                <span class="material-icons-outlined text-navy-900">location_on</span>
              </div>
              <div>
                <p class="text-sm font-bold uppercase tracking-widest text-navy-900/40 mb-1">Location</p>
                <p class="text-lg text-navy-900">Based in Massachusetts, serving clients nationwide.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="prose prose-lg max-w-none">
          <p class="text-gray-600 leading-relaxed mb-8">
            We will respond promptly to discuss your needs and explore how PrimePoint Health can help advance your strategic goals. Whether you have a specific project in mind or just want to learn more about our services, we are here to assist.
          </p>
          
          <p class="text-gray-600 leading-relaxed mb-8">
            Let us partner with you to unlock new possibilities in healthcare excellence. Together, we can make healthcare better for organizations, patients, and communities. We look forward to hearing from you.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 px-4 bg-navy-900 text-center">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-extrabold text-white mb-6">Ready to Transform Your Organization?</h2>
        <p class="text-xl text-gray-300 mb-8">
          Take the first step toward healthcare excellence. Contact us today to schedule a consultation.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="mailto:info@primepointhealth.com" class="inline-block bg-primary hover:bg-opacity-90 text-navy-900 font-bold px-8 py-4 rounded text-sm uppercase tracking-widest transition-all">
            Email Us
          </a>
          <a href="tel:6179708519" class="inline-block border border-white hover:bg-white hover:text-navy-900 text-white font-bold px-8 py-4 rounded text-sm uppercase tracking-widest transition-all">
            Call Us
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>